PORT=5001
HOST=0.0.0.0
NODE_ENV=production
TZ=Asia/Kolkata
APP_TIME_ZONE=Asia/Kolkata
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Either DATABASE_URL or the individual DB_* values may be used.
DATABASE_URL=postgresql://postgres:password@postgres:5432/service_management
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-secure-password
DB_NAME=service_management
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10

CORS_ORIGIN=https://crm.example.com
SEED_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-12-character-password
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_TOTAL_BYTES=2147483648
ENABLE_SCHEDULER=true

# Notification Gateway
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
WHATSAPP_API_URL=
WHATSAPP_AUTH_TOKEN=
SMS_GATEWAY_API_KEY=
RCS_GATEWAY_API_KEY=
VOICE_CALL_API_KEY=

# Generate a random secret of at least 32 characters and include it in the Justdial callback URL.
JUSTDIAL_WEBHOOK_TOKEN=

# CRM asks the existing Apps Script webhook for Website Cms rows. Configure a
# separate CRM_READ_SECRET in Apps Script; never reuse the write webhook secret.
# Set START_AFTER_ID to the largest existing website lead ID at activation.
WEBSITE_SHEET_WEBHOOK_URL=
WEBSITE_SHEET_READ_SECRET=
WEBSITE_SHEET_START_AFTER_ID=
WEBSITE_SHEET_SYNC_INTERVAL_MINUTES=5

# Read-only Google Sheets API service account for the Facebook/Instagram workbook.
# Share the spreadsheet with the service account as Viewer and enable the Sheets API.
# Keep the private key in server environment secrets; escaped \n line breaks are accepted.
FACEBOOK_SHEET_SPREADSHEET_ID=1S-ZvDpj2LSc6-z4Cs35PDzDDmsj-Ht_txQCOCOMeubs
# This is the tab kept on the automatic five-minute sync. Other tabs can be browsed
# and synced on demand from Facebook Leads in the CRM sidebar.
FACEBOOK_SHEET_GID=1497736270
FACEBOOK_SHEET_CLIENT_EMAIL=
FACEBOOK_SHEET_PRIVATE_KEY=
FACEBOOK_SHEET_SYNC_INTERVAL_MINUTES=5
