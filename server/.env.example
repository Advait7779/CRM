PORT=5001
HOST=0.0.0.0
NODE_ENV=production
TZ=Asia/Kolkata
APP_TIME_ZONE=Asia/Kolkata
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Either DATABASE_URL or the individual DB_* values may be used.
DATABASE_URL=postgresql://postgres:password@postgres:5432/service_management
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-secure-password
DB_NAME=service_management
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10

CORS_ORIGIN=https://crm.example.com
SEED_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-12-character-password
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_TOTAL_BYTES=2147483648
ENABLE_SCHEDULER=true

# Notification Gateway
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
WHATSAPP_API_URL=
WHATSAPP_AUTH_TOKEN=
SMS_GATEWAY_API_KEY=
RCS_GATEWAY_API_KEY=
VOICE_CALL_API_KEY=
